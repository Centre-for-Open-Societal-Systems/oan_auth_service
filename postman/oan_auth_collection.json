{
	"info": {
		"_postman_id": "9b3c4f9a-6562-42ea-a45a-c6e3952f41b2",
		"name": "OAN Auth Service API",
		"description": "Postman collection for OAN Auth Service v1 endpoints covering token lifecycle (login, refresh, logout) and password recovery flows.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "",
			"type": "string"
		},
		{
			"key": "user_email",
			"value": "",
			"type": "string"
		},
		{
			"key": "user_password",
			"value": "",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "refresh_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Login",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var baseUrl = pm.environment.get(\"base_url\") || pm.collectionVariables.get(\"base_url\");",
							"var user = pm.environment.get(\"user_email\") || pm.collectionVariables.get(\"user_email\");",
							"if (!baseUrl) {",
							"    console.warn(\"[Pre-request] 'base_url' is empty. Set it in your environment or collection variables.\");",
							"}",
							"if (!user) {",
							"    console.warn(\"[Pre-request] 'user_email' is empty. Set credentials before sending.\");",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"if (pm.response.code === 200) {",
							"    var jsonData = pm.response.json();",
							"    var data = jsonData.message || jsonData;",
							"    if (data && data.access_token) {",
							"        pm.collectionVariables.set(\"access_token\", data.access_token);",
							"        if (pm.environment.name) {",
							"            pm.environment.set(\"access_token\", data.access_token);",
							"        }",
							"        console.log(\"[Post-response] Saved access_token:\", data.access_token);",
							"    }",
							"    if (data && data.refresh_token) {",
							"        pm.collectionVariables.set(\"refresh_token\", data.refresh_token);",
							"        if (pm.environment.name) {",
							"            pm.environment.set(\"refresh_token\", data.refresh_token);",
							"        }",
							"        console.log(\"[Post-response] Saved refresh_token:\", data.refresh_token);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"usr\": \"{{user_email}}\",\n    \"pwd\": \"{{user_password}}\",\n    \"remember_me\": false\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/method/oan_auth_service.api.v1.auth.login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"method",
						"oan_auth_service.api.v1.auth.login"
					]
				},
				"description": "Authenticates user credentials and returns a Bearer access token along with a single-use refresh token."
			},
			"response": []
		},
		{
			"name": "2. Refresh Token",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var refreshToken = pm.environment.get(\"refresh_token\") || pm.collectionVariables.get(\"refresh_token\");",
							"if (!refreshToken) {",
							"    console.warn(\"[Pre-request] 'refresh_token' is empty. Run '1. Login' first to obtain one.\");",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"if (pm.response.code === 200) {",
							"    var jsonData = pm.response.json();",
							"    var data = jsonData.message || jsonData;",
							"    if (data && data.access_token) {",
							"        pm.collectionVariables.set(\"access_token\", data.access_token);",
							"        if (pm.environment.name) {",
							"            pm.environment.set(\"access_token\", data.access_token);",
							"        }",
							"        console.log(\"[Post-response] Rotated access_token:\", data.access_token);",
							"    }",
							"    if (data && data.refresh_token) {",
							"        pm.collectionVariables.set(\"refresh_token\", data.refresh_token);",
							"        if (pm.environment.name) {",
							"            pm.environment.set(\"refresh_token\", data.refresh_token);",
							"        }",
							"        console.log(\"[Post-response] Rotated refresh_token:\", data.refresh_token);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/method/oan_auth_service.api.v1.auth.refresh",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"method",
						"oan_auth_service.api.v1.auth.refresh"
					]
				},
				"description": "Exchanges a single-use refresh token for a fresh access token and a newly rotated refresh token."
			},
			"response": []
		},
		{
			"name": "3. Logout",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var refreshToken = pm.environment.get(\"refresh_token\") || pm.collectionVariables.get(\"refresh_token\");",
							"if (!refreshToken) {",
							"    console.warn(\"[Pre-request] 'refresh_token' is empty.\");",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.collectionVariables.set(\"access_token\", \"\");",
							"pm.collectionVariables.set(\"refresh_token\", \"\");",
							"if (pm.environment.name) {",
							"    pm.environment.set(\"access_token\", \"\");",
							"    pm.environment.set(\"refresh_token\", \"\");",
							"}",
							"console.log(\"[Post-response] Cleared access_token and refresh_token.\");"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/method/oan_auth_service.api.v1.auth.logout",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"method",
						"oan_auth_service.api.v1.auth.logout"
					]
				},
				"description": "Revokes the supplied refresh token row from storage."
			},
			"response": []
		},
		{
			"name": "4. Forgot Password",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var user = pm.environment.get(\"user_email\") || pm.collectionVariables.get(\"user_email\");",
							"if (!user) {",
							"    console.warn(\"[Pre-request] 'user_email' is empty.\");",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"usr\": \"{{user_email}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/method/oan_auth_service.api.v1.auth.forgot_password",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"method",
						"oan_auth_service.api.v1.auth.forgot_password"
					]
				},
				"description": "Triggers a password-reset email without leaking whether the account exists."
			},
			"response": []
		},
		{
			"name": "5. Reset Password",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Pre-request script to verify reset parameters if needed"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"key\": \"reset_key_from_email\",\n    \"new_password\": \"newSecurePassword123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/method/oan_auth_service.api.v1.auth.reset_password",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"method",
						"oan_auth_service.api.v1.auth.reset_password"
					]
				},
				"description": "Completes password reset using key and automatically revokes existing sessions/refresh tokens for that user."
			},
			"response": []
		}
	]
}
