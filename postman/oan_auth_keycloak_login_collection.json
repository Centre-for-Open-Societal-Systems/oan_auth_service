{
  "info": {
    "name": "OAN Auth Service - Keycloak login (IAM)",
    "description": "Login through Keycloak via oan_auth_service /v1/auth/iam/login, scripted end to end (no browser).\n\nRun requests 1-5 in order (or Run collection). Needs the local openg2p-developer stack, so Keycloak and the IAM API are reachable. Set `keycloak_login_key` to an enabled OAN IAM Service key from GET /v1/auth/iam/providers, and `iam_user`/`iam_password` to a user of that IAM's realm.\n\nSelect the \"OAN Auth Keycloak Login (local)\" environment: it holds `base_url`, `return_url`, `keycloak_login_key`, `iam_user` and `iam_password`. The `agent` login option signs in at Keycloak realm `staff` (client `staff-portal`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Start Keycloak login (via IAM)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/auth/iam/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "auth",
            "iam",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"key\": \"{{keycloak_login_key}}\",\n  \"return_url\": \"{{return_url}}\"\n}"
        },
        "description": "Initiates OAuth2 login transaction via OpenG2P IAM for the user."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"keycloak_access_token\");",
              "[\"base_url\",\"return_url\",\"keycloak_login_key\",\"iam_user\",\"iam_password\"].forEach(function (k) {",
              "    if (!pm.variables.get(k)) { throw new Error(\"Set `\" + k + \"` in the OAN Auth Keycloak Login environment\"); }",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "    if (pm.response.code !== 200) { console.error(pm.response.text()); }",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "var data = jsonData.data || jsonData;",
              "pm.test(\"redirect_url returned\", function () {",
              "    pm.expect(data).to.have.property(\"redirect_url\");",
              "});",
              "if (data && data.redirect_url) {",
              "    pm.collectionVariables.set(\"authorization_url\", data.redirect_url);",
              "    console.log(\"[K1] Authorization URL:\", data.redirect_url);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Open Keycloak login form",
      "protocolProfileBehavior": {
        "followRedirects": true
      },
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{authorization_url}}",
          "host": [
            "{{authorization_url}}"
          ]
        },
        "description": "Fetches Keycloak login HTML page and extracts form action URL (mimics browser step)."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var token = pm.collectionVariables.get(\"keycloak_access_token\") || pm.environment.get(\"keycloak_access_token\");",
              "var authUrl = pm.collectionVariables.get(\"authorization_url\");",
              "if (token || !authUrl) { pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "    if (pm.response.code !== 200) { console.error(pm.response.text()); }",
              "    pm.response.to.have.status(200);",
              "});",
              "var html = pm.response.text();",
              "var formMatch = html.match(/<form\\b[^>]*\\bid=[\"']kc-form-login[\"'][^>]*action=[\"']([^\"']+)[\"']/i);",
              "if (!formMatch) { formMatch = html.match(/action=[\"']([^\"']+)[\"']/i); }",
              "pm.test(\"Keycloak login form present\", function () {",
              "    pm.expect(formMatch).to.not.be.null;",
              "});",
              "if (formMatch) {",
              "    var actionUrl = formMatch[1].replace(/&amp;/g, \"&\");",
              "    pm.collectionVariables.set(\"kc_login_action\", actionUrl);",
              "    console.log(\"[K2] Keycloak login action:\", actionUrl);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Sign in to Keycloak",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "{{kc_login_action}}",
          "host": [
            "{{kc_login_action}}"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "{{iam_user}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{iam_password}}",
              "type": "text"
            },
            {
              "key": "credentialId",
              "value": "",
              "type": "text"
            }
          ]
        },
        "description": "Posts credentials to Keycloak login form and captures 302 redirect location to IAM callback."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var token = pm.collectionVariables.get(\"keycloak_access_token\") || pm.environment.get(\"keycloak_access_token\");",
              "var actionUrl = pm.collectionVariables.get(\"kc_login_action\");",
              "if (token || !actionUrl) { pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Keycloak redirects with authorization code (302/303)\", function () {",
              "    pm.expect([302, 303]).to.include(pm.response.code);",
              "});",
              "var location = pm.response.headers.get(\"Location\") || \"\";",
              "pm.test(\"Callback location present\", function () {",
              "    pm.expect(location).to.not.be.empty;",
              "});",
              "if (location) {",
              "    pm.collectionVariables.set(\"iam_callback_url\", location);",
              "    console.log(\"[K3] IAM callback URL:\", location);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Complete IAM callback, keep access token",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{iam_callback_url}}",
          "host": [
            "{{iam_callback_url}}"
          ]
        },
        "description": "Calls IAM callback to complete code exchange and extracts X-Access-Token cookie."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var token = pm.collectionVariables.get(\"keycloak_access_token\") || pm.environment.get(\"keycloak_access_token\");",
              "var cbUrl = pm.collectionVariables.get(\"iam_callback_url\");",
              "if (token || !cbUrl) { pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"IAM callback redirects after exchange (302/303/307)\", function () {",
              "    pm.expect([302, 303, 307]).to.include(pm.response.code);",
              "});",
              "var cookieHeaders = pm.response.headers.all().filter(function (h) {",
              "    return h.key.toLowerCase() === \"set-cookie\";",
              "});",
              "var tokens = cookieHeaders.map(function (h) {",
              "    var match = h.value.match(/^X-Access-Token=([^;]*)/i);",
              "    return match ? match[1].replace(/^\"|\"$/g, \"\") : null;",
              "}).filter(Boolean);",
              "var token = tokens[tokens.length - 1];",
              "pm.test(\"IAM issued access token\", function () {",
              "    pm.expect(token).to.be.a(\"string\").and.not.empty;",
              "});",
              "if (token) {",
              "    pm.collectionVariables.set(\"keycloak_access_token\", token);",
              "    console.log(\"[K4] Acquired keycloak_access_token from IAM cookie\");",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Who am I (verify token)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v1/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "auth",
            "me"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{keycloak_access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "var d = pm.response.json().data || {};",
              "pm.test(\"Returns a user\", function () { pm.expect(JSON.stringify(d)).to.not.equal(\"{}\"); });",
              "console.log(\"[5] /auth/me:\", JSON.stringify(d));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/auth/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "auth",
            "logout"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"access_token\": \"{{keycloak_access_token}}\"\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{keycloak_access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var token = pm.collectionVariables.get(\"keycloak_access_token\") || pm.environment.get(\"keycloak_access_token\");",
              "if (!token) { pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "authorization_url",
      "value": "",
      "type": "string"
    },
    {
      "key": "kc_login_action",
      "value": "",
      "type": "string"
    },
    {
      "key": "iam_callback_url",
      "value": "",
      "type": "string"
    },
    {
      "key": "keycloak_access_token",
      "value": "",
      "type": "string"
    }
  ]
}